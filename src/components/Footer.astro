---
import { profile } from "../data/resume";
---

<footer class="border-t border-gray-200 py-8 dark:border-neutral-800">
	<div class="mx-auto flex max-w-5xl flex-col items-center gap-3 px-4 text-center text-sm text-gray-500 sm:px-6 lg:px-8 dark:text-neutral-400">
		<div class="flex gap-5">
			<a href={profile.github} target="_blank" rel="noopener" class="hover:text-gray-900 dark:hover:text-white">GitHub</a>
			<a href={profile.linkedin} target="_blank" rel="noopener" class="hover:text-gray-900 dark:hover:text-white">LinkedIn</a>
			<a href={`mailto:${profile.email}`} class="hover:text-gray-900 dark:hover:text-white">Email</a>
		</div>
		<p>&copy; {new Date().getFullYear()} {profile.name}</p>
	</div>
</footer>
