---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
	profile,
	about,
	skillGroups,
	experience,
	projects,
	certifications,
	education,
} from "../data/resume";
---

<Layout
	title="Manav Patel — Full Stack Software Engineer"
	description="Full Stack Software Engineer with 2+ years of experience building software across the stack — React/TypeScript front-ends, Java and Node.js services, and AWS cloud infrastructure. AWS Certified Solutions Architect."
>
	<Header />

	<main>
		<!-- Hero -->
		<section class="relative overflow-hidden">
			<div
				class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(115,115,115,0.14),transparent_60%)] dark:bg-[radial-gradient(ellipse_at_top,rgba(163,163,163,0.12),transparent_60%)]"
			>
			</div>
			<div class="relative mx-auto max-w-5xl px-4 pt-24 pb-20 sm:px-6 lg:px-8">
				<span
					class="inline-flex items-center gap-x-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700 dark:border-emerald-900 dark:bg-emerald-950 dark:text-emerald-400"
				>
					<span class="relative flex h-2 w-2">
						<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
						<span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
					</span>
					Open to opportunities
				</span>

				<h1 class="mt-6 text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl dark:text-white">
					Hi, I'm <span
						class="bg-gradient-to-r from-neutral-500 via-neutral-700 to-neutral-900 bg-clip-text text-transparent dark:from-neutral-200 dark:via-neutral-400 dark:to-neutral-500"
						>{profile.name}</span
					>
				</h1>
				<p class="mt-3 text-2xl font-semibold text-gray-700 sm:text-3xl dark:text-neutral-300">
					{profile.role} · AWS Certified Solutions Architect
				</p>
				<p class="mt-5 max-w-2xl text-lg text-gray-600 dark:text-neutral-400">
					{profile.tagline}
				</p>

				<div class="mt-8 flex flex-wrap items-center gap-3">
					<a
						href="#projects"
						class="inline-flex items-center gap-x-2 rounded-lg bg-neutral-800 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-neutral-700 dark:bg-neutral-700 dark:hover:bg-neutral-600"
					>
						View my work
						<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg>
					</a>
					<a
						href={profile.resumeUrl}
						download
						class="inline-flex items-center gap-x-2 rounded-lg border border-gray-300 px-5 py-3 text-sm font-semibold text-gray-800 transition hover:bg-gray-100 dark:border-neutral-600 dark:text-neutral-200 dark:hover:bg-neutral-800"
					>
						Download resume
						<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
					</a>
				</div>

				<div class="mt-8 flex items-center gap-x-5 text-gray-500 dark:text-neutral-400">
					<a href={profile.github} target="_blank" rel="noopener" aria-label="GitHub" class="transition hover:text-gray-900 dark:hover:text-white">
						<svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
					</a>
					<a href={profile.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="transition hover:text-gray-900 dark:hover:text-white">
						<svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>
					</a>
					<a href={`mailto:${profile.email}`} aria-label="Email" class="transition hover:text-gray-900 dark:hover:text-white">
						<svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
					</a>
					<span class="inline-flex items-center gap-x-1.5 text-sm">
						<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg>
						{profile.location}
					</span>
				</div>
			</div>
		</section>

		<!-- About -->
		<section id="about" class="scroll-mt-16 border-t border-gray-200 py-16 dark:border-neutral-800">
			<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
				<h2 class="text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">About</h2>
				<div class="mt-6 grid gap-10 lg:grid-cols-3">
					<div class="space-y-4 text-gray-600 lg:col-span-2 dark:text-neutral-400">
						{about.map((paragraph) => <p>{paragraph}</p>)}
					</div>
					<dl class="grid grid-cols-2 gap-4 self-start lg:grid-cols-1">
						<div class="rounded-xl border border-gray-200 p-4 dark:border-neutral-700">
							<dt class="text-sm text-gray-500 dark:text-neutral-400">Experience</dt>
							<dd class="mt-1 text-2xl font-bold text-gray-900 dark:text-white">2+ years</dd>
						</div>
						<div class="rounded-xl border border-gray-200 p-4 dark:border-neutral-700">
							<dt class="text-sm text-gray-500 dark:text-neutral-400">Certification</dt>
							<dd class="mt-1 text-2xl font-bold text-gray-900 dark:text-white">AWS SAA</dd>
						</div>
					</dl>
				</div>
			</div>
		</section>

		<!-- Skills -->
		<section id="skills" class="scroll-mt-16 border-t border-gray-200 py-16 dark:border-neutral-800">
			<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
				<h2 class="text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">Skills</h2>
				<div class="mt-8 space-y-6">
					{
						skillGroups.map((group) => (
							<div class="flex flex-col gap-3 sm:flex-row sm:items-baseline">
								<h3 class="w-48 shrink-0 text-sm font-semibold tracking-wide text-gray-500 uppercase dark:text-neutral-400">
									{group.label}
								</h3>
								<div class="flex flex-wrap gap-2">
									{group.skills.map((skill) => (
										<span class="rounded-md border border-gray-200 bg-gray-50 px-2.5 py-1 text-sm text-gray-700 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300">
											{skill}
										</span>
									))}
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Experience -->
		<section id="experience" class="scroll-mt-16 border-t border-gray-200 py-16 dark:border-neutral-800">
			<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
				<h2 class="text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">Experience</h2>
				<ol class="mt-8 space-y-10 border-s-2 border-neutral-200 ps-6 dark:border-neutral-800">
					{
						experience.map((job) => (
							<li class="relative">
								<span class="absolute -start-[31px] top-1.5 h-3 w-3 rounded-full border-2 border-neutral-500 bg-white dark:border-neutral-400 dark:bg-neutral-900" />
								<div class="flex flex-wrap items-baseline justify-between gap-x-4">
									<h3 class="text-lg font-semibold text-gray-900 dark:text-white">
										{job.title} · <span class="text-neutral-500 dark:text-neutral-400">{job.company}</span>
									</h3>
									<p class="text-sm font-medium text-gray-500 dark:text-neutral-400">{job.period}</p>
								</div>
								<p class="mt-0.5 text-sm text-gray-500 dark:text-neutral-400">{job.location}</p>
								<ul class="mt-3 list-disc space-y-1.5 ps-4 text-gray-600 dark:text-neutral-400">
									{job.highlights.map((highlight) => (
										<li>{highlight}</li>
									))}
								</ul>
								<div class="mt-3 flex flex-wrap gap-1.5">
									{job.technologies.map((tech) => (
										<span class="rounded bg-neutral-100 px-2 py-0.5 text-xs font-medium text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300">
											{tech}
										</span>
									))}
								</div>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<!-- Projects -->
		<section id="projects" class="scroll-mt-16 border-t border-gray-200 py-16 dark:border-neutral-800">
			<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
				<h2 class="text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">Projects</h2>
				<div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
					{
						projects.map((project) => (
							<article class="flex flex-col rounded-xl border border-gray-200 p-6 transition hover:-translate-y-1 hover:border-neutral-400 hover:shadow-lg dark:border-neutral-700 dark:hover:border-neutral-500">
								<h3 class="text-lg font-semibold text-gray-900 dark:text-white">{project.name}</h3>
								<p class="mt-2 text-sm text-gray-600 dark:text-neutral-400">{project.description}</p>
								<ul class="mt-3 grow list-disc space-y-1 ps-4 text-sm text-gray-600 dark:text-neutral-400">
									{project.highlights.map((highlight) => (
										<li>{highlight}</li>
									))}
								</ul>
								<div class="mt-4 flex flex-wrap gap-1.5">
									{project.technologies.map((tech) => (
										<span class="rounded bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 dark:bg-neutral-800 dark:text-neutral-300">
											{tech}
										</span>
									))}
								</div>
								<div class="mt-4 flex gap-4 border-t border-gray-100 pt-4 text-sm font-semibold dark:border-neutral-800">
									{project.liveUrl && (
										<a href={project.liveUrl} target="_blank" rel="noopener" class="text-neutral-800 underline decoration-neutral-400 underline-offset-4 hover:decoration-neutral-800 dark:text-neutral-200 dark:decoration-neutral-500 dark:hover:decoration-neutral-200">
											Live →
										</a>
									)}
									{project.codeUrl && (
										<a href={project.codeUrl} target="_blank" rel="noopener" class="text-gray-700 hover:underline dark:text-neutral-300">
											Code →
										</a>
									)}
								</div>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<!-- Certification & Education -->
		<section id="education" class="scroll-mt-16 border-t border-gray-200 py-16 dark:border-neutral-800">
			<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
				<div class="grid gap-12 md:grid-cols-2">
					<div>
						<h2 class="text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">Certification</h2>
						{
							certifications.map((cert) => (
								<div class="mt-6 rounded-xl border border-gray-200 p-5 dark:border-neutral-700">
									<h3 class="font-semibold text-gray-900 dark:text-white">{cert.name}</h3>
									<p class="mt-1 text-sm text-gray-500 dark:text-neutral-400">{cert.issuer}</p>
									<a
										href={cert.verifyUrl}
										target="_blank"
										rel="noopener"
										class="mt-3 inline-block text-sm font-semibold text-neutral-800 underline decoration-neutral-400 underline-offset-4 hover:decoration-neutral-800 dark:text-neutral-200 dark:decoration-neutral-500 dark:hover:decoration-neutral-200"
									>
										Verify credential →
									</a>
								</div>
							))
						}
					</div>
					<div>
						<h2 class="text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">Education</h2>
						<div class="mt-6 space-y-4">
							{
								education.map((entry) => (
									<div class="rounded-xl border border-gray-200 p-5 dark:border-neutral-700">
										<h3 class="font-semibold text-gray-900 dark:text-white">{entry.credential}</h3>
										<p class="mt-1 text-sm text-gray-500 dark:text-neutral-400">{entry.school}</p>
										<p class="mt-1 text-sm text-gray-500 dark:text-neutral-400">
											{entry.period} · GPA {entry.gpa}
										</p>
									</div>
								))
							}
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Contact -->
		<section id="contact" class="scroll-mt-16 border-t border-gray-200 py-20 dark:border-neutral-800">
			<div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
				<h2 class="text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">Let's work together</h2>
				<p class="mx-auto mt-3 max-w-xl text-gray-600 dark:text-neutral-400">
					I'm actively looking for full-time software development roles. If you think I'd be a good
					fit for your team, I'd love to hear from you.
				</p>
				<div class="mt-8 flex flex-wrap justify-center gap-3">
					<a
						href={`mailto:${profile.email}`}
						class="inline-flex items-center gap-x-2 rounded-lg bg-neutral-800 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-neutral-700 dark:bg-neutral-700 dark:hover:bg-neutral-600"
					>
						{profile.email}
					</a>
					<a
						href={`tel:${profile.phone.replace(/[^+\d]/g, "")}`}
						class="inline-flex items-center gap-x-2 rounded-lg border border-gray-300 px-5 py-3 text-sm font-semibold text-gray-800 transition hover:bg-gray-100 dark:border-neutral-600 dark:text-neutral-200 dark:hover:bg-neutral-800"
					>
						<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
						{profile.phone}
					</a>
					<a
						href={profile.linkedin}
						target="_blank"
						rel="noopener"
						class="inline-flex items-center gap-x-2 rounded-lg border border-gray-300 px-5 py-3 text-sm font-semibold text-gray-800 transition hover:bg-gray-100 dark:border-neutral-600 dark:text-neutral-200 dark:hover:bg-neutral-800"
					>
						Connect on LinkedIn
					</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
